# Copy to .env for Docker Compose, or export these variables in your shell.
# Do not put real passwords in this file. .env is gitignored.

ASPNETCORE_ENVIRONMENT=Development

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=smartstaff_db
POSTGRES_USER=smartstaff
POSTGRES_PASSWORD=

# Required only when JWT authentication is enabled. Use at least 32 bytes.
JWT_SIGNING_KEY=
JWT_ISSUER=SmartStaff
JWT_AUDIENCE=SmartStaff

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Public API address baked into the frontend. This is not a secret.
VITE_API_URL=http://localhost:5080
